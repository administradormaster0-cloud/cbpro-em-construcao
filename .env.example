# FC Clubs - local environment
# The React client must talk to this project's backend, not the original hosted site.
# Start the API with: npm start
# Then open http://localhost:3000/manage/

VITE_SUPABASE_URL=http://localhost:3000/backend
VITE_SUPABASE_ANON_KEY=local-public-key

# Stripe is optional and not configured in the local server.
VITE_STRIPE_PUBLISHABLE_KEY=

VITE_APP_NAME=FC Clubs
VITE_APP_URL=http://localhost:3000

# Password reset and magic links. Copy into .env.local (gitignored).
# Gmail: smtp.gmail.com port 587. If 2-Step Verification is on, SMTP_PASS must be an app password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
